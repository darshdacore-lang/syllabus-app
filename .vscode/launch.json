{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Electron Main",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
            "args": [
                "app/main.js"
            ],
            "outputCapture": "std"
        },
        {
            "type": "chrome",
            "request": "attach",
            "name": "Attach to Electron Renderer",
            "port": 9222,
            "webRoot": "${workspaceFolder}/app"
        }
    ]
}