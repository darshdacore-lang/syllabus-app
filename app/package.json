{
  "name": "syllabus-app",
  "productName": "Syllabus App",
  "version": "1.0.0",
  "description": "A desktop productivity app packaged for macOS",
  "author": "Darsh Agarwal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.darshagarwal.syllabusapp",
    "productName": "Syllabus App",
    "icon": "build/icon.icns",
    "afterExtract": "./scripts/afterPack.js",
    "afterPack": "./scripts/afterPack.js",
    "mac": {
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "**/*"
    ]
  }
}
